# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# Seven variables have no default and must be supplied: the five reviewed source
# identity values below plus origin_ip and lb_domain. Every OBJECT NAME derives
# from var.component — so you get mcn-ce-ha-eastus01/02/03, mcn-ce-ha-f5se,
# mcn-ce-ha-pool, mcn-ce-ha-rs, mcn-ce-ha-bastion and rg-mcn-ce-ha-<you> without
# naming any of them here. Change component once and all of them follow.

# --- REQUIRED: no defaults, deliberately ---
# These values bind the state and every saved plan to reviewed source. Use the
# exact checked-out branch and commit. Owner and actor are stable non-personal
# identifiers, never names or email addresses.
source_repository   = "f5-sales-demo/multi-cloud-networking"
source_ref          = "refs/heads/main"
source_commit_sha   = "<LOWERCASE_40_HEX_COMMIT>"
deployment_owner_id = "showcase-team"
deployment_actor_id = "terraform-cli"

# origin_ip has no default because any default is one specific machine, and a
# stale one silently sends this deployment's traffic to somebody else's host
# instead of failing. lb_domain has none because the load balancer matches on
# Host: this value is what every request must send, and it belongs to whoever
# runs the deployment.
origin_ip = "203.0.113.10"
lb_domain = "mcn-ce-ha.example.com"

# --- Azure ---
subscription_id = "<AZURE_SUBSCRIPTION_ID>"
location        = "eastus"
# resource_group_name: defaults to rg-<component>-<deployer>, where the deployer is
# resolved from Azure AD. Set it only to adopt a group that already exists.
# resource_group_name = "rg-mcn-ce-ha-yourname"

# --- Scaling / topology ---
ce_count = 3 # 1..3 single-node CE sites (active/active ECMP)
ce_asn   = 64512
rs_asn   = 65515
# region_short: defaults to var.location, and forms the per-CE key and site name
# (component + region -> mcn-ce-ha-eastus01). Set it only when the Azure region
# name is longer than you want inside object names.
# region_short = "eastus"

# --- Network CIDRs (VIP MUST be outside all of these) ---
hub_cidr                   = "10.0.0.0/16"
spoke_cidr                 = "10.1.0.0/16"
mgmt_subnet_prefix         = "10.0.1.0/26"
external_subnet_prefix     = "10.0.2.0/26"
internal_subnet_prefix     = "10.0.3.0/26"
route_server_subnet_prefix = "10.0.4.0/27"
bastion_subnet_prefix      = "10.0.5.0/26" # only used when enable_bastion = true

# --- Object names: all derived, all overridable ---
# Left unset, each of these becomes <component>-<suffix>. Override one only to
# adopt an object that already exists under a different name.
#
# ⚠️ site_prefix is the exception that bites. It feeds ClusterName in cloud-init,
# and cloud-init only runs on a CE's first boot — so changing it REPLACES every CE
# VM and its XC site, followed by roughly 45 minutes of VIP convergence. Pin it to
# the current value when you need existing sites to stay exactly where they are.
#
# site_prefix       = "mcn-ce-ha"   # -> sites mcn-ce-ha-eastus01 / 02 / 03
# lb_name           = "mcn-ce-ha-f5se"
# origin_pool_name  = "mcn-ce-ha-pool"
# route_server_name = "mcn-ce-ha-rs"
# bastion_name      = "mcn-ce-ha-bastion"

# --- Azure Bastion (CE Site Console access) ---
# Off by default: Bastion bills an hourly standing charge whether or not anyone
# connects, and nothing in the BGP/ECMP demo depends on it. Turn it on to reach
# each CE's Site Console web UI (65500, user admin) over an RBAC-controlled tunnel
# instead of an SSH key and a jump host:
#
#   enable_bastion = true
#   terraform apply
#   az network bastion tunnel --name "$(terraform output -raw bastion_name)" \
#     -g "$(terraform output -raw resource_group_name)" \
#     --target-resource-id "$(terraform output -json ce_vm_ids | jq -r .eastus01)" \
#     --resource-port 65500 --port 65500 &
#   open https://localhost:65500/     # log in as admin
#
# Target the VM resource id, not the SLI address: Azure refuses a custom resource
# port over an IP-targeted tunnel (only 22 and 3389 are allowed there).
#
# enable_bastion = true

# --- SSH ---
# Provide the key path (read once at the root) OR paste the material in ssh_public_key.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# --- F5 XC tenant ---
# The tenant is CONFIG, not something XCSH_API_URL decides. Leave it at the default
# unless you are deliberately driving a different tenant, in which case give that
# deployment a state key of its own too — the two belong together (issue #696).
#
# Export only the CREDENTIAL: XCSH_API_TOKEN (or the P12/PEM pair). Any
# XCSH_API_URL naming a different tenant fails the plan with a message saying so,
# rather than quietly rebuilding the demo somewhere else, which is what happened.
#
# expected_xc_tenant = "example-corp"

# --- Customer Edge versions ---
# Empty explicitly selects the latest pair advertised by F5 Distributed Cloud.
# The 64 GB CE disk default was verified with that pair during the clean rebuild
# on 2026-08-03. Set concrete values only when reproducing an older build.
ce_os_version = ""
ce_sw_version = ""

# --- F5 XC data-plane ---
# This pre-existing namespace is read, never created or destroyed. It must exist
# in expected_xc_tenant before the first apply.
xc_app_namespace = "demo-app"
origin_port      = 80
vip              = "10.250.0.10"

# --- Site registration token ---
# Leave unset: an enabled Azure deployment mints its own tenant-scoped token (xcsh_token.ce) and
# feeds its value to cloud-init. Set this only to inject an externally-minted token.
# registration_token = "..."
